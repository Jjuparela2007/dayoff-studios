# ───────────────────────────────────────────────────────────────
#  DayOff Studios — variables de PRODUCCIÓN (Vercel + Aiven + Cloudinary)
#
#  1. Copia este archivo como .env.production (no se sube a GitHub)
#  2. Úsalo desde tu computador para preparar la base de datos:
#       npm run prod:db:init
#       npm run prod:db:seed          (opcional: contenido demo)
#       npm run prod:admin:create
#  3. Copia estas mismas variables en Vercel → Project → Settings → Environment Variables
#     (DB_SSL_CA_FILE NO: en Vercel usa DB_SSL_CA con el contenido del certificado)
# ───────────────────────────────────────────────────────────────

NODE_ENV=production

# Seguridad — genera uno nuevo (NO reutilices el de local):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# ── Base de datos: Aiven for MySQL (Service → Overview → Connection information) ──
DB_HOST=mysql-xxxxxxx-tuusuario.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# En tu computador: descarga el "CA certificate" de Aiven, guárdalo como ca.pem en la raíz del proyecto
DB_SSL_CA_FILE=ca.pem
# En Vercel: pega el CONTENIDO completo del ca.pem (desde -----BEGIN CERTIFICATE----- hasta -----END CERTIFICATE-----)
# DB_SSL_CA=

# ── Cloudinary (Dashboard → API Keys) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dayoff-studios

# Primer administrador (solo para npm run prod:admin:create; usa una clave distinta a la de local)
ADMIN_USER=admin
ADMIN_PASSWORD=
