# ───────────────────────────────────────────────
#  DayOff Studio — variables de entorno
#  Copia este archivo como .env y ajusta los valores
# ───────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=dayoff
DB_PASSWORD=cambia_esta_clave
DB_NAME=dayoff_studio

# Seguridad — genera un secreto largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio
# Duración de la sesión del administrador
JWT_EXPIRES=8h

# Credenciales del primer administrador (solo se usan con `npm run admin:create`)
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaClave!2026

# Límite de subida por archivo, en MB (videos grandes → mejor usar Vimeo/Bunny, ver README)
MAX_UPLOAD_MB=200

# ── Opcional en local ──
# Base de datos con SSL (solo bases en la nube; ver .env.production.example)
# DB_SSL=true
# DB_SSL_CA_FILE=ca.pem
# Cloudinary: si lo configuras, las subidas del panel van a Cloudinary en vez de a /uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
