{
  "name": "dayoff-studio",
  "version": "1.0.0",
  "description": "Sitio web cinematográfico + panel de administración para DayOff Studio",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "railway:start": "node server/scripts/init-db.js && node server/scripts/first-run.js && node server/scripts/update-db.js && node server/server.js",
    "dev": "node --watch server/server.js",
    "db:init": "node server/scripts/init-db.js",
    "db:seed": "node server/scripts/seed.js",
    "db:update": "node server/scripts/update-db.js",
    "db:english": "node server/scripts/translate-en.js",
    "admin:create": "node server/scripts/create-admin.js",
    "prod:db:init": "node server/scripts/init-db.js --env .env.production",
    "prod:db:seed": "node server/scripts/seed.js --env .env.production",
    "prod:db:update": "node server/scripts/update-db.js --env .env.production",
    "prod:admin:create": "node server/scripts/create-admin.js --env .env.production",
    "db:contact": "node server/scripts/set-contact.js",
    "prod:db:contact": "node server/scripts/set-contact.js --env .env.production",
    "demo:clips": "node server/scripts/demo-clips.js",
    "demo:gallery": "node server/scripts/demo-gallery-videos.js",
    "demo:news": "node server/scripts/demo-news.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}